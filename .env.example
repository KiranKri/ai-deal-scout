# Copy to .env and fill in. Only TELEGRAM_BOT_TOKEN is required.
# Never commit .env (it is git-ignored).

# Required: bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: web search (free tier at tavily.com). Without it the other four sources still run.
TAVILY_API_KEY=

# Optional: private data repo for subscribers and seen deals.
# Without both, state is kept in local files under data/ (git-ignored).
GH_PAT=
GH_REPO_DATA=owner/ai-deal-scout-data

# Optional: your numeric Telegram chat ID; enables /status, /run, /quota and failure alerts
ADMIN_CHAT_ID=

# Optional: extra chat IDs allowed to use /run and /quota (comma-separated)
RUN_ALLOWLIST=

# Optional: only for the Render webhook server (bot/bot_server.py)
WEBHOOK_SECRET=
